KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Kafka topics — must match dapplepot_pipeline topic names exactly
KAFKA_EVENTS_TOPIC=obs.events.v1
KAFKA_ALERTS_TOPIC=obs.alerts.v1
KAFKA_DLQ_TOPIC=obs.dlq.v1

POSTGRES_DSN=postgresql://dapplepot:dapplepot@localhost:5432/dapplepot_pipeline
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=dapplepot
CLICKHOUSE_PASSWORD=dapplepot

# Shared Redis instance with dapplepot_pipeline.
# Redis key namespace owned by this service (no overlap with pipeline):
#   dp:sec:sigs:{tenant_id}                   — injection signature cache, TTL SIG_CACHE_TTL_S
#   dp:sec:llm_out:{session_id}:{node_run_id} — LLM completion cache, TTL SESSION_CTX_TTL_S
#   dp:sec:tool_out:{session_id}:{node_run_id}— tool output cache, TTL SESSION_CTX_TTL_S
#   dp:sec:{tenant_id}:agent:{agent_id}:cfg   — per-agent security config, TTL 300s
# Pipeline uses: dp:rules:{tenant_id} — no collision.
REDIS_URL=redis://localhost:6379/0

SECURITY_EVAL_WORKERS=4
SCORER_VERSION=3.0.0
SIG_CACHE_TTL_S=300
SESSION_CTX_TTL_S=120

# v3 composite alert threshold (default 60). Alerts fire when LLM or ASI composite >= this value.
# Can be overridden per-agent via the agent_alert_config table.
ALERT_ON_SCORE_GTE=65

# v3 UBC-05a: cost per 1k tokens (USD) — used for Denial of Wallet detection.
LLM_INPUT_COST_PER_1K=0.01
LLM_OUTPUT_COST_PER_1K=0.03

# Tool manifest (JSON map of agent_id → allowed tool names list)
# Used by out-of-scope tool detection (EA-02a / TME-02a)
TOOL_MANIFESTS={}
